# Install as /opt/sms-v3/shared/app.env; fill via approved secret management.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://CHANGE_ME@127.0.0.1:5432/CHANGE_ME?sslmode=require
DIRECT_URL=postgresql://CHANGE_ME@127.0.0.1:5432/CHANGE_ME?sslmode=require
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
CORS_ORIGIN=https://sms.xvela.app
# true only when the immediate peer is a verified loopback nginx/tunnel.
TRUST_PROXY_LOOPBACK=false
RATE_LIMIT_STORE=postgres
RATE_LIMIT_HASH_SECRET=CHANGE_ME_generate_at_least_32_random_characters
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
DISABLE_EMAIL_NOTIFICATIONS=true
OTP_DELIVERY_PROVIDER=disabled
# SUPABASE_URL=https://CHANGE_ME.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
# LICENSE_DOCUMENTS_BUCKET=CHANGE_ME
# EMPLOYEE_REFERENCE_PHOTOS_BUCKET=CHANGE_ME
# BACKUP_DATABASE_URL=postgresql://CHANGE_ME@127.0.0.1:5432/CHANGE_ME
# BACKUP_DIRECTORY=/opt/sms-v3/shared/backups
# BACKUP_RETENTION_DAYS=30
