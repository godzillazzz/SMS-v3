[Unit]
Description=SMS-v3 Node.js API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=smsv3
Group=smsv3
# Release and every parent directory must be traversable by smsv3 (0755); release files readable (0644).
WorkingDirectory=/opt/sms-v3/app/backend
EnvironmentFile=/opt/sms-v3/shared/app.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/sms-v3/app/backend/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/sms-v3/shared
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
