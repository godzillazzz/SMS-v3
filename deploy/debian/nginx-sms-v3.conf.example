# Current host template: public listener 8080; preserve existing TLS/Cloudflare topology.
# Replace only the documented paths after read-only server inspection.
server {
    listen 8080;
    listen [::]:8080;
    server_name sms.xvela.app;

    root /var/www/sms;
    index index.html;
    client_max_body_size 12m;

    # If Cloudflare terminates TLS, retain its existing forwarding policy.
    # If the origin terminates TLS, configure the existing certificate separately;
    # this package intentionally does not assume or replace that configuration.

    location = /api/v1/health {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, do not append, so a client cannot forge the left-most address.
        # If Cloudflare is the immediate peer, configure its allowlisted real-IP
        # module separately after verifying Cloudflare's published CIDRs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/ready {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, do not append, so a client cannot forge the left-most address.
        # If Cloudflare is the immediate peer, configure its allowlisted real-IP
        # module separately after verifying Cloudflare's published CIDRs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, do not append, so a client cannot forge the left-most address.
        # If Cloudflare is the immediate peer, configure its allowlisted real-IP
        # module separately after verifying Cloudflare's published CIDRs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
