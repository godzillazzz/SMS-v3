# Current verified listener: public HTTP 8080. Do not change to TLS without evidence.
# Choose exactly one public ingress variant; do not combine them.

# VARIANT A: Cloudflare proxied DNS (requires verified orange-cloud DNS and CF CIDRs).
# Include the current Cloudflare IPv4/IPv6 CIDRs from the official allowlist before use.
# The placeholder below is an intentional fail-closed blocker, not a deployable value.
# set_real_ip_from <CLOUDFLARE_CIDR_REQUIRED>;
# real_ip_header CF-Connecting-IP;
# real_ip_recursive off;

server {
    listen 8080;
    listen [::]:8080;
    server_name sms.xvela.app;
    root /var/www/sms;
    index index.html;
    client_max_body_size 12m;

    # Variant A requires host-firewall rules allowing 8080 only from the complete
    # Cloudflare CIDR list. Direct Internet access to 8080 is forbidden.
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_read_timeout 75s;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Headers are defined once at server level to avoid duplicate API headers;
    # Helmet remains the application authority for app-generated responses.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

# VARIANT B: direct/local tunnel is NOT evidenced on the inspected host.
# Do not enable without an approved tunnel process/config and peer mapping.
# With no cloudflared evidence, tunnel mode remains UNKNOWN. For a loopback-only
# tunnel, retain TRUST_PROXY_LOOPBACK=true and bind the tunnel to loopback; never
# expose Node or trust forwarded headers from a public peer.
