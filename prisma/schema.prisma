generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}

enum RegistrationRequestStatus {
  PENDING
  MATCHED
  APPROVED
  REJECTED
}

enum EmployeeLifecycleEventType {
  DEPARTMENT_TRANSFER
  NAME_CHANGE
  POSITION_CHANGE
  EMPLOYMENT_TERMINATION
  REHIRE
  MASTER_EDIT
}

enum EmployeeChangeRequestStatus {
  DRAFT
  PENDING_APPROVAL
  RETURNED_FOR_CORRECTION
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeChangeEffectiveMode {
  IMMEDIATE
  FUTURE_EFFECTIVE
}

enum EmployeeChangeEventAction {
  DRAFT_SAVED
  SUBMIT
  RETURN_FOR_CORRECTION
  RESUBMIT
  APPROVE
  REJECT
  CANCEL
  STALE_CONFLICT
  APPLY_EFFECTIVE
}

enum EmployeeLifecycleEventStatus {
  PENDING
  APPLIED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  REFRESH
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE
  PASSKEY_REGISTERED
  PASSKEY_LOGIN_SUCCESS
  PASSKEY_LOGIN_FAILED
  PASSKEY_REVOKED
}

enum AuthOtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum WebAuthnChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum AttendanceDeviceEnrollmentStatus {
  PENDING_APPROVAL
  ACTIVE
  REVOKED
  REJECTED
  CANCELLED
}

enum AttendanceDeviceRequestType {
  INITIAL
  REPLACEMENT
}

enum AttendanceDeviceChangeRequestStatus {
  PENDING_APPROVAL
  RETURNED_FOR_CORRECTION
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceDeviceChallengePurpose {
  DEVICE_ENROLLMENT
  ATTENDANCE_EVENT
  PATROL_EVENT
}

enum EmployeeReferencePhotoStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum FaceVerificationPurpose {
  ATTENDANCE_EVENT
  PATROL_EVENT
}

enum FaceVerificationSessionStatus {
  CREATED
  DEVICE_PROOF_VERIFIED
  PROVIDER_PENDING
  VERIFIED
  FAILED
  EXPIRED
  CONSUMED
}

model User {
  id                                String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                             String                            @unique @db.VarChar(255)
  passwordHash                      String                            @map("password_hash") @db.VarChar(255)
  displayName                       String                            @map("display_name") @db.VarChar(150)
  role                              UserRole                          @default(VIEWER)
  isActive                          Boolean                           @default(true) @map("is_active")
  tokenVersion                      Int                               @default(0) @map("token_version")
  lastLoginAt                       DateTime?                         @map("last_login_at")
  failedLoginCount                  Int                               @default(0) @map("failed_login_count")
  legacyUserId                      String?                           @unique @map("legacy_user_id") @db.VarChar(100)
  employeeId                        String?                           @unique @map("employee_id") @db.Uuid
  legacyRole                        String?                           @map("legacy_role") @db.VarChar(50)
  accountStatus                     AccountStatus                     @default(ACTIVE) @map("account_status")
  passwordResetRequired             Boolean                           @default(false) @map("password_reset_required")
  employmentSuspendedAt             DateTime?                         @map("employment_suspended_at")
  department                        String?                           @db.VarChar(100)
  requestedAt                       DateTime?                         @map("requested_at")
  approvedByLegacyRef               String?                           @map("approved_by_legacy_ref") @db.VarChar(255)
  approvedAt                        DateTime?                         @map("approved_at")
  rejectionReason                   String?                           @map("rejection_reason") @db.VarChar(2000)
  legacyUpdatedAt                   DateTime?                         @map("legacy_updated_at")
  createdAt                         DateTime                          @default(now()) @map("created_at")
  updatedAt                         DateTime                          @updatedAt @map("updated_at")
  auditLogs                         AuditLog[]                        @relation("ActorAuditLogs")
  sessions                          RefreshSession[]
  otpChallenges                     AuthOtpChallenge[]
  webAuthnCredentials               WebAuthnCredential[]
  webAuthnChallenges                WebAuthnChallenge[]
  uploadedLicenseDocuments          EmployeeLicenseDocument[]         @relation("UploadedLicenseDocuments")
  reviewedLicenseDocuments          EmployeeLicenseDocument[]         @relation("ReviewedLicenseDocuments")
  returnedLicenseDocuments          EmployeeLicenseDocument[]         @relation("ReturnedLicenseDocuments")
  submittedLicenseDocumentRevisions EmployeeLicenseDocumentRevision[] @relation("SubmittedLicenseDocumentRevisions")
  employee                          Employee?                         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdLeaveRequests              LeaveRequest[]                    @relation("LeaveRequestCreatedBy")
  lifecycleEventsChanged            EmployeeLifecycleEvent[]          @relation("LifecycleChangedBy")
  reviewedRegistrationRequests      RegistrationRequest[]             @relation("RegistrationRequestReviewedBy")
  employeeChangeRequestsOwned       EmployeeChangeRequest[]           @relation("EmployeeChangeRequestOwner")
  employeeChangeRevisionsSubmitted  EmployeeChangeRequestRevision[]   @relation("EmployeeChangeRevisionSubmitter")
  employeeChangeEventsActed         EmployeeChangeRequestEvent[]      @relation("EmployeeChangeEventActor")
  attendanceDevicesCreated          AttendanceDeviceEnrollment[]      @relation("AttendanceDeviceCreatedBy")
  attendanceDevicesApproved         AttendanceDeviceEnrollment[]      @relation("AttendanceDeviceApprovedBy")
  attendanceDeviceRequestsCreated   AttendanceDeviceChangeRequest[]   @relation("AttendanceDeviceRequestedBy")
  attendanceDeviceRequestsReviewed  AttendanceDeviceChangeRequest[]   @relation("AttendanceDeviceReviewedBy")
  referencePhotosUploaded           EmployeeReferencePhoto[]          @relation("EmployeeReferencePhotoUploadedBy")
  referencePhotosReviewed           EmployeeReferencePhoto[]          @relation("EmployeeReferencePhotoReviewedBy")
  faceVerificationSessions          FaceVerificationSession[]         @relation("FaceVerificationSessionUser")
  faceVerificationReceipts          FaceVerificationReceipt[]         @relation("FaceVerificationReceiptUser")

  @@map("users")
}

model RegistrationRequest {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submittedName     String                    @map("submitted_name") @db.VarChar(200)
  email             String                    @unique @db.VarChar(255)
  passwordHash      String?                   @map("password_hash") @db.VarChar(255)
  departmentHint    String?                   @map("department_hint") @db.VarChar(100)
  status            RegistrationRequestStatus @default(PENDING)
  emailVerifiedAt   DateTime?                 @map("email_verified_at")
  matchedEmployeeId String?                   @map("matched_employee_id") @db.Uuid
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at")
  approvedAt        DateTime?                 @map("approved_at")
  rejectedAt        DateTime?                 @map("rejected_at")
  rejectionReason   String?                   @map("rejection_reason") @db.VarChar(1000)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  matchedEmployee   Employee?                 @relation(fields: [matchedEmployeeId], references: [id], onDelete: SetNull)
  reviewedBy        User?                     @relation("RegistrationRequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([emailVerifiedAt, status])
  @@index([matchedEmployeeId])
  @@map("registration_requests")
}

model AuthOtpChallenge {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  emailHash     String         @map("email_hash") @db.Char(64)
  purpose       AuthOtpPurpose
  codeHash      String         @map("code_hash") @db.Char(64)
  expiresAt     DateTime       @map("expires_at")
  attempts      Int            @default(0)
  maxAttempts   Int            @default(5) @map("max_attempts")
  consumedAt    DateTime?      @map("consumed_at")
  deliveryState String         @default("PENDING") @map("delivery_state") @db.VarChar(30)
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailHash, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otp_challenges")
}

model WebAuthnCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id") @db.VarChar(512)
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   Json?
  deviceType   String?   @map("device_type") @db.VarChar(32)
  backedUp     Boolean   @default(false) @map("backed_up")
  displayName  String    @default("Passkey") @map("display_name") @db.VarChar(120)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose       WebAuthnChallengePurpose
  userId        String?                  @map("user_id") @db.Uuid
  challengeHash String                   @unique @map("challenge_hash") @db.Char(64)
  expiresAt     DateTime                 @map("expires_at")
  consumedAt    DateTime?                @map("consumed_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  user          User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt, consumedAt])
  @@index([userId, purpose, expiresAt])
  @@map("webauthn_challenges")
}

model AttendanceDeviceEnrollment {
  id                       String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId               String                           @map("employee_id") @db.Uuid
  publicKey                Bytes                            @map("public_key")
  keyAlgorithm             String                           @map("key_algorithm") @db.VarChar(50)
  credentialFingerprint    String                           @unique @map("credential_fingerprint") @db.Char(64)
  displayName              String                           @map("display_name") @db.VarChar(120)
  platformHint             String?                          @map("platform_hint") @db.VarChar(100)
  userAgentSnapshot        String?                          @map("user_agent_snapshot") @db.VarChar(500)
  status                   AttendanceDeviceEnrollmentStatus @default(PENDING_APPROVAL)
  proofVerifiedAt          DateTime?                        @map("proof_verified_at")
  enrolledAt               DateTime                         @default(now()) @map("enrolled_at")
  activatedAt              DateTime?                        @map("activated_at")
  revokedAt                DateTime?                        @map("revoked_at")
  revokedReason            String?                          @map("revoked_reason") @db.VarChar(1000)
  createdByUserId          String                           @map("created_by_user_id") @db.Uuid
  approvedByUserId         String?                          @map("approved_by_user_id") @db.Uuid
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  employee                 Employee                         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy                User                             @relation("AttendanceDeviceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy               User?                            @relation("AttendanceDeviceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  challenges               AttendanceDeviceChallenge[]
  candidateForRequest      AttendanceDeviceChangeRequest?   @relation("CandidateAttendanceDevice")
  currentForRequests       AttendanceDeviceChangeRequest[]  @relation("CurrentAttendanceDevice")
  faceVerificationSessions FaceVerificationSession[]
  faceVerificationReceipts FaceVerificationReceipt[]

  @@index([employeeId, status])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId])
  @@map("attendance_device_enrollments")
}

model AttendanceDeviceChallenge {
  id                      String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId              String                           @map("employee_id") @db.Uuid
  deviceEnrollmentId      String?                          @map("device_enrollment_id") @db.Uuid
  purpose                 AttendanceDeviceChallengePurpose
  challengeHash           String                           @unique @map("challenge_hash") @db.Char(64)
  expiresAt               DateTime                         @map("expires_at")
  consumedAt              DateTime?                        @map("consumed_at")
  createdAt               DateTime                         @default(now()) @map("created_at")
  employee                Employee                         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  deviceEnrollment        AttendanceDeviceEnrollment?      @relation(fields: [deviceEnrollmentId], references: [id], onDelete: Cascade)
  faceVerificationSession FaceVerificationSession?

  @@index([employeeId, purpose, expiresAt, consumedAt])
  @@index([deviceEnrollmentId, purpose, expiresAt])
  @@map("attendance_device_challenges")
}

model AttendanceDeviceChangeRequest {
  id                          String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                  String                              @map("employee_id") @db.Uuid
  requestType                 AttendanceDeviceRequestType         @map("request_type")
  status                      AttendanceDeviceChangeRequestStatus @default(PENDING_APPROVAL)
  requestedByUserId           String                              @map("requested_by_user_id") @db.Uuid
  candidateDeviceEnrollmentId String                              @unique @map("candidate_device_enrollment_id") @db.Uuid
  currentDeviceEnrollmentId   String?                             @map("current_device_enrollment_id") @db.Uuid
  reason                      String?                             @db.VarChar(1000)
  reviewerComment             String?                             @map("reviewer_comment") @db.VarChar(1000)
  reviewedByUserId            String?                             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt                  DateTime?                           @map("reviewed_at")
  returnedAt                  DateTime?                           @map("returned_at")
  cancelledAt                 DateTime?                           @map("cancelled_at")
  createdAt                   DateTime                            @default(now()) @map("created_at")
  updatedAt                   DateTime                            @updatedAt @map("updated_at")
  employee                    Employee                            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy                 User                                @relation("AttendanceDeviceRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy                  User?                               @relation("AttendanceDeviceReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  candidateDevice             AttendanceDeviceEnrollment          @relation("CandidateAttendanceDevice", fields: [candidateDeviceEnrollmentId], references: [id], onDelete: Restrict)
  currentDevice               AttendanceDeviceEnrollment?         @relation("CurrentAttendanceDevice", fields: [currentDeviceEnrollmentId], references: [id], onDelete: Restrict)

  @@index([employeeId, status, createdAt])
  @@index([requestedByUserId, status])
  @@index([reviewedByUserId, reviewedAt])
  @@map("attendance_device_change_requests")
}

model RefreshSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  tokenVersion     Int       @map("token_version")
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Employee {
  id                          String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode                String                          @unique @map("employee_code") @db.VarChar(50)
  firstName                   String                          @map("first_name") @db.VarChar(100)
  lastName                    String                          @map("last_name") @db.VarChar(100)
  email                       String?                         @unique @db.VarChar(255)
  phone                       String?                         @db.VarChar(50)
  department                  String?                         @db.VarChar(100)
  jobTitle                    String?                         @map("job_title") @db.VarChar(100)
  hiredAt                     DateTime?                       @map("hired_at") @db.Date
  isActive                    Boolean                         @default(true) @map("is_active")
  deletedAt                   DateTime?                       @map("deleted_at")
  deletedByUserId             String?                         @map("deleted_by_user_id") @db.Uuid
  legacyEmployeeId            String?                         @unique @map("legacy_employee_id") @db.VarChar(100)
  displayName                 String?                         @map("display_name") @db.VarChar(255)
  skill                       String?                         @db.VarChar(255)
  createdAt                   DateTime                        @default(now()) @map("created_at")
  updatedAt                   DateTime                        @updatedAt @map("updated_at")
  user                        User?
  licenses                    EmployeeLicense[]
  licenseDocuments            EmployeeLicenseDocument[]
  shiftAssignments            ShiftAssignment[]
  leaveRequests               LeaveRequest[]
  leaveQuotas                 LeaveQuota[]
  lifecycleEvents             EmployeeLifecycleEvent[]
  matchedRegistrationRequests RegistrationRequest[]
  changeRequests              EmployeeChangeRequest[]
  changeRequestEvents         EmployeeChangeRequestEvent[]
  attendanceDevices           AttendanceDeviceEnrollment[]
  attendanceDeviceChallenges  AttendanceDeviceChallenge[]
  attendanceDeviceRequests    AttendanceDeviceChangeRequest[]
  referencePhotos             EmployeeReferencePhoto[]
  faceVerificationSessions    FaceVerificationSession[]
  faceVerificationReceipts    FaceVerificationReceipt[]

  @@index([isActive, deletedAt])
  @@index([department])
  @@map("employees")
}

model EmployeeReferencePhoto {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                 String                       @map("employee_id") @db.Uuid
  status                     EmployeeReferencePhotoStatus @default(PENDING_APPROVAL)
  storageProvider            String                       @map("storage_provider") @db.VarChar(50)
  storageBucket              String                       @map("storage_bucket") @db.VarChar(255)
  storageObjectKey           String                       @unique @map("storage_object_key") @db.VarChar(500)
  originalFileName           String                       @map("original_file_name") @db.VarChar(255)
  safeDisplayFileName        String                       @map("safe_display_file_name") @db.VarChar(255)
  mimeType                   String                       @map("mime_type") @db.VarChar(100)
  fileSize                   Int                          @map("file_size")
  checksum                   String                       @db.Char(64)
  imageWidth                 Int                          @map("image_width")
  imageHeight                Int                          @map("image_height")
  uploadedByUserId           String                       @map("uploaded_by_user_id") @db.Uuid
  uploadedByRoleSnapshot     String                       @map("uploaded_by_role_snapshot") @db.VarChar(50)
  uploadedAt                 DateTime                     @default(now()) @map("uploaded_at")
  reviewedByUserId           String?                      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt                 DateTime?                    @map("reviewed_at")
  rejectionReason            String?                      @map("rejection_reason") @db.VarChar(1000)
  activatedAt                DateTime?                    @map("activated_at")
  supersededAt               DateTime?                    @map("superseded_at")
  storageDeletionRequestedAt DateTime?                    @map("storage_deletion_requested_at")
  storageDeletedAt           DateTime?                    @map("storage_deleted_at")
  storageDeleteAttempts      Int                          @default(0) @map("storage_delete_attempts")
  storageDeleteLastErrorAt   DateTime?                    @map("storage_delete_last_error_at")
  storageDeleteLastErrorCode String?                      @map("storage_delete_last_error_code") @db.VarChar(80)
  cancelledAt                DateTime?                    @map("cancelled_at")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  employee                   Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  uploadedBy                 User                         @relation("EmployeeReferencePhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy                 User?                        @relation("EmployeeReferencePhotoReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  faceVerificationSessions   FaceVerificationSession[]
  faceVerificationReceipts   FaceVerificationReceipt[]

  @@index([employeeId, status, createdAt])
  @@index([status, storageDeletionRequestedAt, storageDeletedAt])
  @@index([uploadedByUserId, createdAt])
  @@map("employee_reference_photos")
}

model FaceVerificationSession {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                  String                        @map("employee_id") @db.Uuid
  userId                      String                        @map("user_id") @db.Uuid
  deviceEnrollmentId          String                        @map("device_enrollment_id") @db.Uuid
  deviceCredentialFingerprint String                        @map("device_credential_fingerprint") @db.Char(64)
  referencePhotoId            String                        @map("reference_photo_id") @db.Uuid
  referencePhotoChecksum      String                        @map("reference_photo_checksum") @db.Char(64)
  deviceChallengeId           String                        @unique @map("device_challenge_id") @db.Uuid
  purpose                     FaceVerificationPurpose
  status                      FaceVerificationSessionStatus @default(CREATED)
  contextDigest               String                        @map("context_digest") @db.Char(64)
  provider                    String?                       @db.VarChar(80)
  providerSessionRefHash      String?                       @map("provider_session_ref_hash") @db.Char(64)
  providerPolicyProfileId     String?                       @map("provider_policy_profile_id") @db.VarChar(120)
  providerEngineVersion       String?                       @map("provider_engine_version") @db.VarChar(120)
  providerResultCode          String?                       @map("provider_result_code") @db.VarChar(80)
  padPassed                   Boolean?                      @map("pad_passed")
  faceMatchPassed             Boolean?                      @map("face_match_passed")
  injectionRiskDetected       Boolean?                      @map("injection_risk_detected")
  deviceProofVerifiedAt       DateTime?                     @map("device_proof_verified_at")
  verifiedAt                  DateTime?                     @map("verified_at")
  failedAt                    DateTime?                     @map("failed_at")
  failureCode                 String?                       @map("failure_code") @db.VarChar(80)
  expiresAt                   DateTime                      @map("expires_at")
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")
  employee                    Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user                        User                          @relation("FaceVerificationSessionUser", fields: [userId], references: [id], onDelete: Restrict)
  deviceEnrollment            AttendanceDeviceEnrollment    @relation(fields: [deviceEnrollmentId], references: [id], onDelete: Restrict)
  referencePhoto              EmployeeReferencePhoto        @relation(fields: [referencePhotoId], references: [id], onDelete: Restrict)
  deviceChallenge             AttendanceDeviceChallenge     @relation(fields: [deviceChallengeId], references: [id], onDelete: Restrict)
  receipt                     FaceVerificationReceipt?

  @@index([employeeId, purpose, status, expiresAt])
  @@index([deviceEnrollmentId, purpose, status, expiresAt])
  @@index([referencePhotoId, status, createdAt])
  @@index([userId, createdAt])
  @@map("face_verification_sessions")
}

model FaceVerificationReceipt {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId                   String                     @unique @map("session_id") @db.Uuid
  employeeId                  String                     @map("employee_id") @db.Uuid
  userId                      String                     @map("user_id") @db.Uuid
  deviceEnrollmentId          String                     @map("device_enrollment_id") @db.Uuid
  deviceCredentialFingerprint String                     @map("device_credential_fingerprint") @db.Char(64)
  referencePhotoId            String                     @map("reference_photo_id") @db.Uuid
  referencePhotoChecksum      String                     @map("reference_photo_checksum") @db.Char(64)
  purpose                     FaceVerificationPurpose
  receiptHash                 String                     @unique @map("receipt_hash") @db.Char(64)
  contextDigest               String                     @map("context_digest") @db.Char(64)
  issuedAt                    DateTime                   @default(now()) @map("issued_at")
  expiresAt                   DateTime                   @map("expires_at")
  consumedAt                  DateTime?                  @map("consumed_at")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  session                     FaceVerificationSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee                    Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user                        User                       @relation("FaceVerificationReceiptUser", fields: [userId], references: [id], onDelete: Restrict)
  deviceEnrollment            AttendanceDeviceEnrollment @relation(fields: [deviceEnrollmentId], references: [id], onDelete: Restrict)
  referencePhoto              EmployeeReferencePhoto     @relation(fields: [referencePhotoId], references: [id], onDelete: Restrict)

  @@index([employeeId, purpose, expiresAt, consumedAt])
  @@index([deviceEnrollmentId, purpose, expiresAt, consumedAt])
  @@index([referencePhotoId, issuedAt])
  @@map("face_verification_receipts")
}

model EmployeeLifecycleEvent {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                  String                       @map("employee_id") @db.Uuid
  sequence                    Int
  type                        EmployeeLifecycleEventType
  status                      EmployeeLifecycleEventStatus @default(PENDING)
  effectiveDate               DateTime                     @map("effective_date") @db.Date
  oldValue                    Json                         @map("old_value")
  newValue                    Json                         @map("new_value")
  reason                      String                       @db.VarChar(1000)
