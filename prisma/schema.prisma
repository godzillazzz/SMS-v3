generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  REFRESH
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE
}

enum AuthOtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                    @unique @db.VarChar(255)
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  displayName              String                    @map("display_name") @db.VarChar(150)
  role                     UserRole                  @default(VIEWER)
  isActive                 Boolean                   @default(true) @map("is_active")
  tokenVersion             Int                       @default(0) @map("token_version")
  lastLoginAt              DateTime?                 @map("last_login_at")
  failedLoginCount         Int                       @default(0) @map("failed_login_count")
  legacyUserId             String?                   @unique @map("legacy_user_id") @db.VarChar(100)
  employeeId               String?                   @unique @map("employee_id") @db.Uuid
  legacyRole               String?                   @map("legacy_role") @db.VarChar(50)
  accountStatus            AccountStatus             @default(ACTIVE) @map("account_status")
  passwordResetRequired    Boolean                   @default(false) @map("password_reset_required")
  department               String?                   @db.VarChar(100)
  requestedAt              DateTime?                 @map("requested_at")
  approvedByLegacyRef      String?                   @map("approved_by_legacy_ref") @db.VarChar(255)
  approvedAt               DateTime?                 @map("approved_at")
  rejectionReason          String?                   @map("rejection_reason") @db.VarChar(2000)
  legacyUpdatedAt          DateTime?                 @map("legacy_updated_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  auditLogs                AuditLog[]                @relation("ActorAuditLogs")
  sessions                 RefreshSession[]
  otpChallenges            AuthOtpChallenge[]
  uploadedLicenseDocuments EmployeeLicenseDocument[] @relation("UploadedLicenseDocuments")
  reviewedLicenseDocuments EmployeeLicenseDocument[] @relation("ReviewedLicenseDocuments")
  returnedLicenseDocuments EmployeeLicenseDocument[] @relation("ReturnedLicenseDocuments")
  employee                 Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdLeaveRequests     LeaveRequest[]            @relation("LeaveRequestCreatedBy")

  @@map("users")
}

model AuthOtpChallenge {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  emailHash     String         @map("email_hash") @db.Char(64)
  purpose       AuthOtpPurpose
  codeHash      String         @map("code_hash") @db.Char(64)
  expiresAt     DateTime       @map("expires_at")
  attempts      Int            @default(0)
  maxAttempts   Int            @default(5) @map("max_attempts")
  consumedAt    DateTime?      @map("consumed_at")
  deliveryState String         @default("PENDING") @map("delivery_state") @db.VarChar(30)
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailHash, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otp_challenges")
}

model RefreshSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  tokenVersion     Int       @map("token_version")
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Employee {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode     String                    @unique @map("employee_code") @db.VarChar(50)
  firstName        String                    @map("first_name") @db.VarChar(100)
  lastName         String                    @map("last_name") @db.VarChar(100)
  email            String?                   @unique @db.VarChar(255)
  phone            String?                   @db.VarChar(50)
  department       String?                   @db.VarChar(100)
  jobTitle         String?                   @map("job_title") @db.VarChar(100)
  hiredAt          DateTime?                 @map("hired_at") @db.Date
  isActive         Boolean                   @default(true) @map("is_active")
  deletedAt        DateTime?                 @map("deleted_at")
  deletedByUserId  String?                   @map("deleted_by_user_id") @db.Uuid
  legacyEmployeeId String?                   @unique @map("legacy_employee_id") @db.VarChar(100)
  displayName      String?                   @map("display_name") @db.VarChar(255)
  skill            String?                   @db.VarChar(255)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  user             User?
  licenses         EmployeeLicense[]
  licenseDocuments EmployeeLicenseDocument[]
  shiftAssignments ShiftAssignment[]
  leaveRequests    LeaveRequest[]
  leaveQuotas      LeaveQuota[]

  @@index([isActive, deletedAt])
  @@index([department])
  @@map("employees")
}

model ShiftType {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String            @unique @db.VarChar(50)
  name             String            @db.VarChar(150)
  startTime        String?           @map("start_time") @db.VarChar(20)
  endTime          String?           @map("end_time") @db.VarChar(20)
  hours            Decimal           @db.Decimal(6, 2)
  color            String?           @db.VarChar(50)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  shiftAssignments ShiftAssignment[]

  @@map("shift_types")
}

model ShiftAssignment {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                    String    @map("employee_id") @db.Uuid
  shiftTypeId                   String    @map("shift_type_id") @db.Uuid
  workDate                      DateTime  @map("work_date") @db.Date
  employeeNameSnapshot          String    @map("employee_name_snapshot") @db.VarChar(255)
  departmentSnapshot            String?   @map("department_snapshot") @db.VarChar(100)
  startTime                     String?   @map("start_time") @db.VarChar(20)
  endTime                       String?   @map("end_time") @db.VarChar(20)
  hours                         Decimal   @db.Decimal(6, 2)
  remark                        String?   @db.VarChar(2000)
  source                        String?   @db.VarChar(100)
  locked                        Boolean   @default(false)
  updatedByLegacyRef            String?   @map("updated_by_legacy_ref") @db.VarChar(255)
  legacyUpdatedAt               DateTime? @map("legacy_updated_at")
  licenseStatus                 String?   @map("license_status") @db.VarChar(100)
  licenseExpiryDate             DateTime? @map("license_expiry_date") @db.Date
  licenseOverride               Boolean   @default(false) @map("license_override")
  licenseBlockedFromShiftTypeId String?   @map("license_blocked_from_shift_type_id") @db.Uuid
  licenseBlockedFromRemark      String?   @map("license_blocked_from_remark") @db.VarChar(2000)
  licenseBlockedAt              DateTime? @map("license_blocked_at")
  overrideReason                String?   @map("override_reason") @db.VarChar(2000)
  overrideByLegacyRef           String?   @map("override_by_legacy_ref") @db.VarChar(255)
  overrideAt                    DateTime? @map("override_at")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  employee                      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftType                     ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)

  @@unique([workDate, employeeId])
  @@index([employeeId, workDate])
  @@index([shiftTypeId, workDate])
  @@map("shift_assignments")
}

model EmployeeLicense {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyLicenseId         String                    @unique @map("legacy_license_id") @db.VarChar(100)
  employeeId              String                    @map("employee_id") @db.Uuid
  licenseType             String                    @map("license_type") @db.VarChar(150)
  licenseNumber           String?                   @map("license_number") @db.VarChar(255)
  issueDate               DateTime?                 @map("issue_date") @db.Date
  expiryDate              DateTime?                 @map("expiry_date") @db.Date
  status                  String?                   @db.VarChar(100)
  documentUrl             String?                   @map("document_url") @db.VarChar(2000)
  documentMigrationStatus String                    @default("NONE") @map("document_migration_status") @db.VarChar(40)
  remark                  String?                   @db.VarChar(2000)
  updatedByLegacyRef      String?                   @map("updated_by_legacy_ref") @db.VarChar(255)
  legacyUpdatedAt         DateTime?                 @map("legacy_updated_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  employee                Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  documents               EmployeeLicenseDocument[]

  @@index([employeeId])
  @@index([expiryDate])
  @@map("employee_licenses")
}

enum LicenseDocumentStatus {
  PENDING
  RETURNED_FOR_CORRECTION
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

model EmployeeLicenseDocument {
  id                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                   String                @map("employee_id") @db.Uuid
  licenseId                    String                @map("license_id") @db.Uuid
  storageProvider              String                @map("storage_provider") @db.VarChar(50)
  storageBucket                String                @map("storage_bucket") @db.VarChar(255)
  storageObjectKey             String                @unique @map("storage_object_key") @db.VarChar(500)
  originalFileName             String                @map("original_file_name") @db.VarChar(255)
  safeDisplayFileName          String                @map("safe_display_file_name") @db.VarChar(255)
  mimeType                     String                @map("mime_type") @db.VarChar(100)
  fileSize                     Int                   @map("file_size")
  checksum                     String?               @db.Char(64)
  proposedStartDate            DateTime              @map("proposed_start_date") @db.Date
  proposedExpiryDate           DateTime              @map("proposed_expiry_date") @db.Date
  proposedLicenseNumber        String?               @map("proposed_license_number") @db.VarChar(100)
  status                       LicenseDocumentStatus @default(PENDING)
  isCurrent                    Boolean               @default(false) @map("is_current")
  uploadedById                 String                @map("uploaded_by_id") @db.Uuid
  uploadedAt                   DateTime              @default(now()) @map("uploaded_at")
  reviewedById                 String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt                   DateTime?             @map("reviewed_at")
  rejectionReason              String?               @map("rejection_reason") @db.VarChar(2000)
  correctionReason             String?               @map("correction_reason") @db.VarChar(1000)
  returnedById                 String?               @map("returned_by_id") @db.Uuid
  returnedAt                   DateTime?             @map("returned_at")
  resubmittedAt                DateTime?             @map("resubmitted_at")
  version                      Int
  note                         String?               @db.VarChar(2000)
  storageDeleteAfter           DateTime?             @map("storage_delete_after")
  storageDeletedAt             DateTime?             @map("storage_deleted_at")
  storageDeleteObjectKey       String?               @map("storage_delete_object_key") @db.VarChar(500)
  storageDeleteAttempts        Int                   @default(0) @map("storage_delete_attempts")
  storageDeleteLastErrorAt     DateTime?             @map("storage_delete_last_error_at")
  storageDeleteLastErrorCode   String?               @map("storage_delete_last_error_code") @db.VarChar(80)
  immediateDeletionRequestedAt DateTime?             @map("immediate_deletion_requested_at")
  expirationProcessedAt        DateTime?             @map("expiration_processed_at")
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")
  employee                     Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  license                      EmployeeLicense       @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  uploadedBy                   User                  @relation("UploadedLicenseDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy                   User?                 @relation("ReviewedLicenseDocuments", fields: [reviewedById], references: [id], onDelete: Restrict)
  returnedBy                   User?                 @relation("ReturnedLicenseDocuments", fields: [returnedById], references: [id], onDelete: Restrict)

  @@unique([licenseId, version])
  @@index([employeeId, status])
  @@index([licenseId, isCurrent])
  @@index([proposedExpiryDate])
  @@index([status, isCurrent, expirationProcessedAt])
  @@index([storageDeleteObjectKey])
  @@map("employee_license_documents")
}

model LeaveRequest {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFingerprint         String           @unique @map("source_fingerprint") @db.VarChar(64)
  employeeId                String           @map("employee_id") @db.Uuid
  requestedAt               DateTime         @map("requested_at")
  employeeNameSnapshot      String           @map("employee_name_snapshot") @db.VarChar(255)
  departmentSnapshot        String?          @map("department_snapshot") @db.VarChar(100)
  leaveType                 String           @map("leave_type") @db.VarChar(100)
  startDate                 DateTime         @map("start_date") @db.Date
  endDate                   DateTime         @map("end_date") @db.Date
  dayCount                  Decimal          @map("day_count") @db.Decimal(6, 2)
  reason                    String?          @db.VarChar(2000)
  attachmentUrl             String?          @map("attachment_url") @db.VarChar(2000)
  attachmentMigrationStatus String           @default("NONE") @map("attachment_migration_status") @db.VarChar(40)
  status                    String           @db.VarChar(100)
  approvedByLegacyRef       String?          @map("approved_by_legacy_ref") @db.VarChar(255)
  approvedAt                DateTime?        @map("approved_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  createdByUserId           String?          @map("created_by_user_id") @db.Uuid
  employee                  Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser             User?            @relation("LeaveRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachment                LeaveAttachment?

  @@index([employeeId, startDate])
  @@index([status])
  @@index([createdByUserId])
  @@map("leave_requests")
}

model LeaveAttachment {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId      String       @unique @map("leave_request_id") @db.Uuid
  fileName            String       @map("file_name") @db.VarChar(255)
  mimeType            String       @map("mime_type") @db.VarChar(100)
  sizeBytes           Int          @map("size_bytes")
  sha256              String       @db.Char(64)
  content             Bytes
  uploadedByLegacyRef String?      @map("uploaded_by_legacy_ref") @db.VarChar(255)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  leaveRequest        LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("leave_attachments")
}

model LeaveQuota {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFingerprint    String    @unique @map("source_fingerprint") @db.VarChar(64)
  employeeId           String?   @map("employee_id") @db.Uuid
  employeeNameSnapshot String    @map("employee_name_snapshot") @db.VarChar(255)
  sickLeave            Decimal   @map("sick_leave") @db.Decimal(7, 2)
  personalLeave        Decimal   @map("personal_leave") @db.Decimal(7, 2)
  vacationLeave        Decimal   @map("vacation_leave") @db.Decimal(7, 2)
  matchStatus          String    @map("match_status") @db.VarChar(30)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  employee             Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([matchStatus])
  @@map("leave_quotas")
}

model ScheduleApproval {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month               DateTime  @db.Date
  status              String    @db.VarChar(100)
  revision            Int
  changedByLegacyRef  String?   @map("changed_by_legacy_ref") @db.VarChar(255)
  changedAt           DateTime? @map("changed_at")
  changeType          String?   @map("change_type") @db.VarChar(100)
  approvedByLegacyRef String?   @map("approved_by_legacy_ref") @db.VarChar(255)
  approvedAt          DateTime? @map("approved_at")
  approvalNote        String?   @map("approval_note") @db.VarChar(2000)
  scheduleHash        String?   @map("schedule_hash") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([month, revision])
  @@index([month, status])
  @@map("schedule_approvals")
}

model ScheduleApprovalEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFingerprint    String   @unique @map("source_fingerprint") @db.VarChar(64)
  occurredAt           DateTime @map("occurred_at")
  action               String   @db.VarChar(100)
  month                DateTime @db.Date
  revision             Int
  status               String?  @db.VarChar(100)
  changeType           String?  @map("change_type") @db.VarChar(100)
  performedByLegacyRef String?  @map("performed_by_legacy_ref") @db.VarChar(255)
  note                 String?  @db.VarChar(2000)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([month, occurredAt])
  @@map("schedule_approval_events")
}

model SchedulingRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId    String   @unique @map("rule_id") @db.VarChar(100)
  name      String   @db.VarChar(255)
  value     String   @db.VarChar(1000)
  unit      String?  @db.VarChar(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scheduling_rules")
}

model SystemSetting {
  key         String   @id @db.VarChar(150)
  value       String   @db.VarChar(2000)
  description String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model LegacyUserAuditEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFingerprint    String   @unique @map("source_fingerprint") @db.VarChar(64)
  occurredAt           DateTime @map("occurred_at")
  action               String   @db.VarChar(100)
  legacyUserId         String?  @map("legacy_user_id") @db.VarChar(100)
  emailSnapshot        String?  @map("email_snapshot") @db.VarChar(255)
  roleSnapshot         String?  @map("role_snapshot") @db.VarChar(50)
  departmentSnapshot   String?  @map("department_snapshot") @db.VarChar(100)
  reason               String?  @db.VarChar(2000)
  performedByLegacyRef String?  @map("performed_by_legacy_ref") @db.VarChar(255)
  legacyEmployeeId     String?  @map("legacy_employee_id") @db.VarChar(100)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([legacyUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("legacy_user_audit_events")
}

model LegacyLicenseAuditEvent {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFingerprint   String    @unique @map("source_fingerprint") @db.VarChar(64)
  occurredAt          DateTime  @map("occurred_at")
  action              String    @db.VarChar(100)
  legacyEmployeeId    String?   @map("legacy_employee_id") @db.VarChar(100)
  legacyLicenseId     String?   @map("legacy_license_id") @db.VarChar(100)
  workDate            DateTime? @map("work_date") @db.Date
  shiftCode           String?   @map("shift_code") @db.VarChar(50)
  licenseStatus       String?   @map("license_status") @db.VarChar(100)
  expiryDate          DateTime? @map("expiry_date") @db.Date
  reason              String?   @db.VarChar(2000)
  approvedByLegacyRef String?   @map("approved_by_legacy_ref") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([legacyEmployeeId, occurredAt])
  @@index([action, occurredAt])
  @@map("legacy_license_audit_events")
}

// Ready for use by auditService; fields stay database-agnostic for migration.
model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String      @map("entity_id") @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  actor       User?       @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model RateLimitBucket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String   @db.VarChar(50)
  keyHash     String   @map("key_hash") @db.VarChar(64)
  windowStart DateTime @map("window_start")
  count       Int      @default(1)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AlertDeduplicationState {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventCategory         String    @map("event_category") @db.VarChar(64)
  dedupKeyHash          String    @map("dedup_key_hash") @db.VarChar(64)
  severity              String    @db.VarChar(16)
  windowStart           DateTime  @map("window_start")
  occurrenceCount       Int       @default(1) @map("occurrence_count")
  lastOccurrenceAt      DateTime  @map("last_occurrence_at")
  deliveryStatus        String    @default("pending") @map("delivery_status") @db.VarChar(16)
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at")
  cooldownUntil         DateTime  @map("cooldown_until")
  expiresAt             DateTime  @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([eventCategory, dedupKeyHash, windowStart], map: "alert_deduplication_states_event_hash_window_key")
  @@index([expiresAt], map: "alert_deduplication_states_expires_at_idx")
  @@map("alert_deduplication_states")
}

model EmailDeliveryReservation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey           String    @unique @map("event_key") @db.VarChar(255)
  status             String    @default("RESERVED") @db.VarChar(16)
  attemptCount       Int       @default(1) @map("attempt_count")
  reservedAt         DateTime  @default(now()) @map("reserved_at")
  sentAt             DateTime? @map("sent_at")
  failedAt           DateTime? @map("failed_at")
  retryAfter         DateTime? @map("retry_after")
  lastErrorCategory  String?   @map("last_error_category") @db.VarChar(64)
  lastErrorSafe      String?   @map("last_error_safe") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, retryAfter])
  @@map("email_delivery_reservations")
}
