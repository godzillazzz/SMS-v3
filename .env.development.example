NODE_ENV=development
DATABASE_URL="postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@localhost:5432/sms_v3_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="30m"
JWT_ALGORITHM="HS256"
JWT_ISSUER="smsv3-api"
JWT_AUDIENCE="smsv3-clients"
CORS_ORIGIN="http://localhost:5173"
REFRESH_TOKEN_EXPIRES_DAYS=14
