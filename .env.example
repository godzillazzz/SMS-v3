# PostgreSQL connection. Change the host only when moving from cloud to company server.
DATABASE_URL="postgresql://smsv3_user:change_me@localhost:5432/smsv3?schema=public"

# Use a long, random value in every deployed environment.
RATE_LIMIT_STORE=memory
RATE_LIMIT_HASH_SECRET=
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="30m"
JWT_ALGORITHM="HS256"
JWT_ISSUER="smsv3-api"
JWT_AUDIENCE="smsv3-clients"

PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REFRESH_TOKEN_EXPIRES_DAYS=14
REFRESH_TOKEN_EXPIRES_IN="14d"
AUTH_COOKIE_NAME="smsv3_refresh"
CSRF_COOKIE_NAME="smsv3_csrf"
COOKIE_SAME_SITE="lax"
# COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# Required only when the Vercel daily license-reconciliation cron is enabled.
CRON_SECRET="replace-with-a-long-random-secret"

# Private Supabase storage. Production requires separate private buckets for governed files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LICENSE_DOCUMENTS_BUCKET=private-license-documents
EMPLOYEE_REFERENCE_PHOTOS_BUCKET=employee-reference-photos

# Email OTP. Keep disabled until all SMTP values are supplied through the deployment secret store.
OTP_DELIVERY_PROVIDER="disabled"
OTP_HASH_SECRET=
OTP_FROM_EMAIL=
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USERNAME=
SMTP_PASSWORD=
OTP_CODE_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_HOUR=5

# Alert delivery remains disabled until a provider, owners and thresholds are approved.
ALERTING_ENABLED=false
ALERTING_PROVIDER=disabled
ALERT_COOLDOWN_SECONDS=300
ALERT_DEDUP_STORE=memory
ALERT_DEDUP_HASH_SECRET=
ALERT_DEDUP_RETENTION_SECONDS=604800
# ALERT_LOGIN_FAILURE_THRESHOLD=
# ALERT_REFRESH_FAILURE_THRESHOLD=
# ALERT_HTTP_429_THRESHOLD=
# ALERT_DATABASE_LATENCY_MS=
# ALERT_FUNCTION_TIMEOUT_THRESHOLD=

# Used only by `npm run db:seed`; never commit a real production password.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-production"
SEED_ADMIN_NAME="System Administrator"

# Optional: used later by the scheduled backup worker.
BACKUP_DIRECTORY="./backups"
BACKUP_RETENTION_DAYS=30
# Optional executable path and argument template for encryption. The command
# receives {input} and {output} paths; keep encryption keys outside this file.
# BACKUP_ENCRYPT_COMMAND=""
# BACKUP_ENCRYPT_ARGS="{input} {output}"
# One-time legacy import safety switch. Keep false for normal runtime.
LEGACY_MIGRATION_ALLOW_WRITE=false
LEGACY_MIGRATION_TARGET_CONFIRMATION=local
