{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "G06FaceVerificationPreviewBackend",
      "Effect": "Allow",
      "Action": [
        "rekognition:CreateFaceLivenessSession",
        "rekognition:GetFaceLivenessSessionResults",
        "rekognition:CompareFaces"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-7"
        }
      }
    }
  ]
}
