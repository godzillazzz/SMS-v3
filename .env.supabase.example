# Development project only. Never use production credentials here or in frontend code.
# Use a pooled URL for API runtime and a direct URL only for Prisma migrations.
RATE_LIMIT_STORE=postgres
RATE_LIMIT_HASH_SECRET=
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:PORT/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="30m"
JWT_ALGORITHM="HS256"
JWT_ISSUER="smsv3-api"
JWT_AUDIENCE="smsv3-clients"
CORS_ORIGIN="http://localhost:5173"
REFRESH_TOKEN_EXPIRES_DAYS=14
ALERTING_ENABLED=false
ALERTING_PROVIDER=disabled
ALERT_COOLDOWN_SECONDS=300
ALERT_DEDUP_STORE=memory
ALERT_DEDUP_HASH_SECRET=
ALERT_DEDUP_RETENTION_SECONDS=604800
# ALERT_LOGIN_FAILURE_THRESHOLD=
# ALERT_REFRESH_FAILURE_THRESHOLD=
# ALERT_HTTP_429_THRESHOLD=
# ALERT_DATABASE_LATENCY_MS=
# ALERT_FUNCTION_TIMEOUT_THRESHOLD=
