  "variables": {
    "DATABASE_URL": {
      "purpose": "Runtime connection for the environment's application database",
      "masterSource": "Owner-controlled recoverable secret manager or database provider credentials",
      "sensitive": true,
      "runtimeRequired": true,
      "shared": false,
      "scopes": ["production", "preview", "development"],
      "branchOverrideAllowed": "preview-exception-only",
      "ownerNotes": "Project-specific. Preview must be an approved isolated non-Production target; never copy Production credentials."
    },
    "DIRECT_URL": {
      "purpose": "Prisma migration/direct connection target",
      "masterSource": "Owner-controlled recoverable secret manager or database provider credentials",
      "sensitive": true,
      "runtimeRequired": true,
      "shared": false,
      "scopes": ["production", "preview", "development"],
      "branchOverrideAllowed": "preview-exception-only",
      "ownerNotes": "Must identify the same logical database as DATABASE_URL and use an approved direct/session mode."
    },
    "SUPABASE_URL": {
      "purpose": "Private storage provider endpoint",
      "masterSource": "Owner-controlled secret manager or Supabase project settings",
      "sensitive": false,
      "runtimeRequired": "production",
      "shared": false,
      "scopes": ["production", "preview"],
      "branchOverrideAllowed": false,
      "ownerNotes": "Project-bound; do not use Shared Environment Variables by default."
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "purpose": "Server-only private storage access",
      "masterSource": "Owner-controlled password manager or Supabase project settings",
      "sensitive": true,
      "runtimeRequired": "production",
      "shared": false,
      "scopes": ["production", "preview"],
      "branchOverrideAllowed": false,
      "ownerNotes": "Never expose to browser, Git, logs, PR text, screenshots, or chat."
    },
    "JWT_SECRET": {
      "purpose": "JWT signing key",
      "masterSource": "Owner-controlled recoverable secret manager",
      "sensitive": true,
      "runtimeRequired": true,
      "shared": false,
      "scopes": ["production", "preview", "development"],
      "branchOverrideAllowed": "preview-exception-only",
      "ownerNotes": "Use distinct high-entropy values per deployed environment."
    },
    "CORS_ORIGIN": {
      "purpose": "Credentialed browser origin allowlist",
      "masterSource": "Repository policy plus Owner-approved deployment configuration",
      "sensitive": false,
      "runtimeRequired": true,
      "shared": false,
      "scopes": ["production", "preview", "development"],
      "branchOverrideAllowed": "preview-exception-only",
      "ownerNotes": "No wildcard. Preview may add its validated own Vercel origin; Production remains explicit."
    },
    "APPROVED_DATABASE_TARGET_FINGERPRINT": {
      "purpose": "Non-secret Production logical database identity guard",
      "masterSource": "Owner-approved release governance record",
      "sensitive": false,
      "runtimeRequired": "production-release",
      "shared": false,
      "scopes": ["production"],
      "branchOverrideAllowed": false,
      "ownerNotes": "SHA-256 logical target fingerprint only; never a credential."
    },
    "APPROVED_PREVIEW_DATABASE_TARGET_FINGERPRINT": {
      "purpose": "Non-secret isolated Preview logical database identity guard",
      "masterSource": "Owner-approved Preview environment record",
      "sensitive": false,
      "runtimeRequired": "preview-release",
      "shared": false,
      "scopes": ["preview"],
      "branchOverrideAllowed": false,
      "ownerNotes": "Required for a governed Preview visual witness; must not equal the Production fingerprint."
    },
    "RUN_MIGRATIONS": {
      "purpose": "Explicit release migration policy input",
      "masterSource": "Approved release manifest/workflow input",
      "sensitive": false,
      "runtimeRequired": "release",
      "shared": false,
      "scopes": ["production", "preview"],
      "branchOverrideAllowed": false,
      "ownerNotes": "Must be explicit. Default release policy is false unless separately governed."
    }
