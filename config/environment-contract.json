{
  "schemaVersion": 1,
  "project": {
    "name": "sms-v3-staging",
    "projectId": "prj_XwhNUOB2zLSPZ6UgQcfyOKBYJ75s",
    "teamId": "team_nemCExHbZ8EAhSgsvefHPAEz",
    "canonicalProductionOrigin": "https://sms-v3-staging-ten.vercel.app"
  },
  "source": {
    "environmentSchema": "src/config/env.js",
    "prismaSchema": "prisma/schema.prisma",
    "corsImplementation": "src/config/env.js",
    "branchOverridePolicy": "Branch overrides are Preview-only exceptions and are never required by ordinary unbranched Preview deployments."
  },
  "environments": {
    "production": {
      "vercelEnv": "production",
      "required": [
        "DATABASE_URL",
        "DIRECT_URL",
        "JWT_SECRET",
        "CORS_ORIGIN",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "LICENSE_DOCUMENTS_BUCKET",
        "EMPLOYEE_REFERENCE_PHOTOS_BUCKET"
      ],
      "requiredGuards": ["APPROVED_DATABASE_TARGET_FINGERPRINT", "RUN_MIGRATIONS"],
      "database": {
        "targetClass": "production",
        "fingerprintVariable": "APPROVED_DATABASE_TARGET_FINGERPRINT",
        "branchOverrideAllowed": false,
        "productionFallbackAllowed": false
      },
      "cors": {
        "mode": "explicit",
        "allowValidatedVercelOrigins": false,
        "allowWildcard": false,
        "requiredCanonicalOrigin": "https://sms-v3-staging-ten.vercel.app",
        "rejectLocalhost": true
      },
      "migrationPolicy": "explicit"
    },
    "preview": {
      "vercelEnv": "preview",
      "required": ["DATABASE_URL", "DIRECT_URL", "JWT_SECRET", "CORS_ORIGIN"],
      "requiredGuards": ["APPROVED_PREVIEW_DATABASE_TARGET_FINGERPRINT"],
      "database": {
        "targetClass": "isolated-non-production",
        "fingerprintVariable": "APPROVED_PREVIEW_DATABASE_TARGET_FINGERPRINT",
        "branchOverrideAllowed": true,
        "branchOverrideRequired": false,
        "productionFallbackAllowed": false
      },
      "cors": {
        "mode": "explicit-plus-own-vercel-origin",
        "allowValidatedVercelOrigins": true,
        "allowWildcard": false,
        "rejectLocalhost": false
      },
      "migrationPolicy": "false"
    },
    "development": {
      "vercelEnv": "development",
      "required": ["DATABASE_URL", "JWT_SECRET"],
      "requiredGuards": [],
      "database": {
        "targetClass": "local-or-explicit-development",
        "branchOverrideAllowed": false,
        "productionFallbackAllowed": false
      },
      "cors": {
        "mode": "explicit",
        "allowValidatedVercelOrigins": false,
        "allowWildcard": false,
        "rejectLocalhost": false
      },
      "migrationPolicy": "explicit"
    }
  },
