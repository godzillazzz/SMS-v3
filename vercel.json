{
    "version":  2,
    "buildCommand":  "npm run vercel-build",
    "outputDirectory":  "frontend/dist",
    "functions":  {
                      "api/[...path].js":  {
                                               "maxDuration":  60
                                           }
                  },
    "crons":  [
                  {
                      "path":  "/api/v1/internal/license-reconciliation",
                      "schedule":  "5 17 * * *"
                  }
              ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-cache, no-store, must-revalidate"
                                        }
                                    ]
                    }
                ],
    "routes":  [
                   {
                       "src":  "/api/(.*)",
                       "dest":  "/api/[...path].js"
                   },
                   {
                       "handle":  "filesystem"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/index.html"
                   }
               ],
    "git":  {
                "deploymentEnabled":  {
                                          "ci/g04-staged-focused-technical-v1":  false
                                      }
            }
}