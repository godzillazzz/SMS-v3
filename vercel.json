{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/v1/internal/license-reconciliation", "schedule": "5 17 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "test/automated-uat-v3-authenticated": false,
      "ci/g04-focused-auth-uat-v1": false,
      "ci/g04-focused-auth-uat-v1-freeze-1": false
    }
  }
}
