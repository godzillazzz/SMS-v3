{
  "name": "smsv3",
  "version": "0.1.0",
  "private": true,
  "description": "smsv3 backend foundation",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "backup": "node scripts/backup.js",
    "verify-backup": "node scripts/verify-backup.js",
    "migration:legacy:dry-run": "node scripts/migrate-legacy-data.js",
    "migration:legacy:apply": "node scripts/migrate-legacy-data.js --apply",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:uat": "playwright test",
    "test:uat:check": "node --test test/uat-config.test.js && playwright test --list",
    "db:test:migrate": "prisma migrate deploy",
    "vercel-build": "node scripts/vercel-production-build.js",
    "environment:contract": "node scripts/ci/verify-environment-contract.js --contract-only",
    "environment:linux-artifact": "node scripts/ci/verify-linux-artifact.js .vercel/output --require-sharp-load",
    "prisma:format:check": "prisma format --check",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1116.0",
    "@prisma/client": "^6.11.1",
    "@simplewebauthn/server": "13.3.2",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@vladmandic/human": "3.3.6",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "sharp": "0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "nodemon": "^3.1.10",
    "prisma": "^6.11.1",
    "supertest": "^7.1.1"
  }
}
